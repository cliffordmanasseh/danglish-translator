# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.venv/
venv/

# Desktop build artifacts (models and the PyInstaller sidecar are large)
desktop/node_modules/
desktop/resources/backend/
desktop/resources/models/
desktop/release/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Raw model outputs (large; may contain copyrighted source text)
models/
*.onnx
*.onnx.json
*.safetensors

# Raw experiment predictions/references (may contain copyrighted text)
experiments/results/**/*.json
experiments/results/**/*.jsonl

# Scraped sermon corpus (copyrighted unless marked public_domain; do not commit)
data/sermons/

# Release model weights (large; verify with release/sermon-model/SHA256SUMS)
release/sermon-model/*.gguf

# Local runtime output and caches
*.wav
*.mp3
*.log
.cache/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
